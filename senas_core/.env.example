# Copia este archivo a ".env" (sin ".example") y completa tus valores.
# El .env real NUNCA se sube a git -- cada persona del equipo tiene el suyo.

# Obligatorio para ingest_video.py y reconocer_video.py.
# Supabase -> tu proyecto -> Settings -> Database -> Connection string -> URI.
# Reemplaza [YOUR-PASSWORD] por la contraseña que pusiste al crear el proyecto.
DATABASE_URL=postgresql://postgres:[UNIVOZ20331140]@db.qykmadkmwhntxhbjltnc.supabase.co:5432/postgres

# Opcional: solo si quieres que ingest_video.py suba el video original a
# Supabase Storage (asi el equipo puede abrirlo para revisar antes de
# aprobar una muestra). Si los dejas vacios, todo lo demas funciona igual.
# Supabase -> Settings -> API -> Project URL / service_role secret.
# El service_role key tiene acceso total: no lo pongas en la app de
# Flutter, solo en este .env de scripts que corren en tu maquina.
SUPABASE_URL="postgresql://postgres.qykmadkmwhntxhbjltnc:[UNIVOZ20331140]@aws-0-ca-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=videos
